<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_bringup</name>
  <version>0.1.0</version>
  <description>Robot description and launch files for the UR5 + Robotiq Hand-E table rig.</description>
  <maintainer email="1056862@students.wits.ac.za">researcher</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ur5_control</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_client_library</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <!-- Not on the ROS index; see ur5_integration.repos -->
  <exec_depend>robotiq_hande_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
